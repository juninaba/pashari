// Copy this file to Config/Local.xcconfig and fill in your own values.
// Local.xcconfig is git-ignored, so your team ID never ends up in the repo.
//
//   cp Config/Local.xcconfig.example Config/Local.xcconfig
//
// Your team ID is the 10-character ID shown in Xcode under
// Settings > Accounts > (your Apple ID) > Team. A free Apple ID has a
// "Personal Team", which is enough for development.

DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development
