    "The annotations and crop could not be applied to the screenshot." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注釈と切り抜きをスクリーンショットに反映できませんでした。"
          }
        }
      }
    },
    "The display to capture could not be found." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャするディスプレイが見つかりませんでした。"
          }
        }
      }
    },
    "The screenshot could not be converted to PNG." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットをPNGに変換できませんでした。"
          }
        }
      }
    },
    "The screenshot could not be copied" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットをコピーできませんでした"
          }
        }
      }
    },
    "The screenshot could not be saved" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットを保存できませんでした"
          }
        }
      }
    },
    "The screenshot could not be saved to %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットを %@ に保存できませんでした。"
          }
        }
      }
    },
    "The screenshot could not be taken" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットを撮れませんでした"
          }
        }
      }
    },
    "The thumbnail holds the screenshot without your changes" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルには変更前のスクリーンショットが入っています"
          }
        }
      }
    },
    "Turn on Pashari under Privacy & Security > Screen & System Audio Recording in System Settings, then quit and reopen Pashari." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定の「プライバシーとセキュリティ」>「画面収録とシステムオーディオ録音」でPashariをオンにしてから、Pashariを終了して開き直してください。"
          }
        }
      }
    },
